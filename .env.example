# Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Kalshi API (same keys as the crypto bot)
KALSHI_API_KEY_ID=your_kalshi_api_key_id
KALSHI_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# The Odds API (free at https://the-odds-api.com -- 500 req/month)
ODDS_API_KEY=your_odds_api_key

# Strategy
MIN_EDGE_PCT=0.05
MAX_GAMES_PER_POLL=5
POLL_INTERVAL_SECONDS=14400

# Risk
ACCOUNT_STOP_LOSS_PCT=0.30
POSITION_FRACTION=0.02
MAX_TRADE_USD=50.0
MIN_TRADE_USD=5.0

# Mode (set to false when ready to go live)
PAPER_MODE=true
PAPER_STARTING_BALANCE=500.0
